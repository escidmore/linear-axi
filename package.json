{
  "name": "@escidmore/linear-axi",
  "version": "0.3.0",
  "description": "Community-maintained AXI wrapper for the Linear MCP server",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "linear-axi": "bin/linear-axi.js"
  },
  "files": [
    "bin",
    "docs/demo.webm",
    "skills",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "demo": "vhs docs/demo.tape",
    "check": "node --check bin/linear-axi.js && node --check src/*.js && node --check src/commands/*.js && node --check src/lib/*.js && node --test",
    "prepublishOnly": "npm run check",
    "test": "node --test"
  },
  "keywords": [
    "linear",
    "mcp",
    "cli",
    "axi",
    "agent",
    "agent-skills"
  ],
  "author": "escidmore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/escidmore/linear-axi.git"
  },
  "bugs": {
    "url": "https://github.com/escidmore/linear-axi/issues"
  },
  "homepage": "https://github.com/escidmore/linear-axi#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@toon-format/toon": "^2.3.1",
    "axi-sdk-js": "^0.1.8"
  }
}
